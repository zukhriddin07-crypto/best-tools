// Best Tools — Prisma Schema
// PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



// =============================================
// BRENDLAR
// =============================================
model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

// =============================================
// KATEGORIYALAR (daraxt tuzilmasi)
// =============================================
model Category {
  id       String     @id @default(cuid())
  name     String
  nameRu   String?
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]
  image    String?
  order    Int        @default(0)
}

// =============================================
// MAHSULOTLAR
// =============================================
model Product {
  id                   String      @id @default(cuid())
  name                 String
  nameRu               String?
  slug                 String      @unique
  sku                  String      @unique
  description          String      @db.Text
  descriptionRu        String?     @db.Text
  shortDesc            String?
  specs                Json?
  images               String[]
  price                Decimal     @db.Decimal(12, 2)
  oldPrice             Decimal?    @db.Decimal(12, 2)
  stock                Int         @default(0)
  brandId              String
  brand                Brand       @relation(fields: [brandId], references: [id])
  categoryId           String
  category             Category    @relation(fields: [categoryId], references: [id])
  isActive             Boolean     @default(true)
  isFeatured           Boolean     @default(false)
  installmentAvailable Boolean     @default(true)
  views                Int         @default(0)
  rating               Float       @default(0)
  metaTitle            String?
  metaDescription      String?
  orderItems           OrderItem[]
  reviews              Review[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

// =============================================
// MIJOZLAR
// =============================================
model Customer {
  id         String     @id @default(cuid())
  phone      String     @unique
  name       String?
  email      String?
  telegramId String?    @unique
  addresses  Address[]
  orders     Order[]
  cart       CartItem[]
  reviews    Review[]
  createdAt  DateTime   @default(now())
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  region     String
  city       String
  street     String
  house      String
  apartment  String?
  isDefault  Boolean  @default(false)
}

// =============================================
// SAVAT (Web + Telegram umumiy)
// =============================================
model CartItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  productId  String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// =============================================
// BUYURTMALAR
// =============================================
model Order {
  id                String         @id @default(cuid())
  orderNumber       String         @unique
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  status            OrderStatus    @default(PENDING)
  paymentStatus     PaymentStatus  @default(UNPAID)
  paymentMethod     PaymentMethod
  totalAmount       Decimal        @db.Decimal(12, 2)
  deliveryAmount    Decimal        @db.Decimal(12, 2) @default(0)
  deliveryAddress   Json
  deliveryMethod    DeliveryMethod
  trackingNumber    String?
  installmentMonths Int?
  note              String?
  source            OrderSource    @default(WEB)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  name      String
}

// =============================================
// ENUMLAR
// =============================================
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
}

enum PaymentMethod {
  CLICK
  PAYME
  UZUM_NASIYA
  CASH_ON_DELIVERY
}

enum DeliveryMethod {
  BTS_EXPRESS
  YANDEX_DELIVERY
  PICKUP
}

enum OrderSource {
  WEB
  TELEGRAM
}

// =============================================
// SHARHLAR
// =============================================
model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int
  text       String?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// =============================================
// ADMIN FOYDALANUVCHILAR
// =============================================
model Admin {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      AdminRole @default(MANAGER)
  createdAt DateTime  @default(now())
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  CONTENT
}

// =============================================
// PROMOKODLAR
// =============================================
model Promo {
  id         String     @id @default(cuid())
  code       String     @unique
  discount   Int
  type       PromoType
  minAmount  Decimal?   @db.Decimal(12, 2)
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int        @default(0)
  isActive   Boolean    @default(true)
}

enum PromoType {
  PERCENT
  FIXED
}

// =============================================
// SMS / TELEGRAM OTP KODLAR
// =============================================
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
